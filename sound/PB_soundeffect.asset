category = {
	name = "PB Effects"
	soundeffects = {
		culture_acceptance_click
		culture_conversion_click
		RUS_creepy_radio
		RUS_eliminate_leader_click
		RUS_feedback_loop
		RUS_hidden_radio
		WMD_click
	}
	compressor = {
	   enabled = yes
	   pregain = 3.0
	   postgain = 0.0
	   ratio = 10.0
	   threshold = -15.0
	   attacktime = 0.030
	   releasetime = 1.2
	}
}

